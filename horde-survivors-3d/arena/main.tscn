[node name="Survivors" type="Node3D"]
script = ExtResource("1")

[node name="Channel" type="Node" parent="."]
script = ExtResource("3")

[node name="Objects" type="Node" parent="."]

[node name="Spawner" type="NetcodeSpawner" parent="Objects"]
spawn_path = NodePath("..")
spawnable_scenes = Array[PackedScene]([ExtResource("4"), ExtResource("5"), ExtResource("6")])

[node name="Arena" type="Node3D" parent="."]
script = ExtResource("2")
effect_scene = ExtResource("9")
enemy_hit_tint = Color(1, 0.945098, 0.737255, 1)
enemy_windup_tint = Color(1, 0.85098, 0.537255, 1)
stone_tint = Color(0.501961, 0.945098, 0.827451, 1)

[node name="Presentation" parent="Arena" instance=ExtResource("8")]

[node name="Map" parent="." instance=ExtResource("7")]

[node name="EnemyTypes" parent="." instance=ExtResource("10")]

[connection signal="message" from="Channel" to="." method="receive"]
[connection signal="movement" from="Channel" to="." method="receive_axis"]
[connection signal="spawned" from="Objects/Spawner" to="." method="register_state"]
[connection signal="despawned" from="Objects/Spawner" to="." method="unregister_state"]
