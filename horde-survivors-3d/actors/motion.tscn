[gd_scene format=3]

[ext_resource type="Script" path="res://actors/state.gd" id="1"]

[sub_resource type="NetcodeReplicationConfig" id="Fields"]
properties = Array[NodePath]([NodePath(":entity_id"), NodePath(":controller"), NodePath(":position_xz"), NodePath(":facing"), NodePath(":velocity"), NodePath(":source_step"), NodePath(":team")])
apply_proxy_changes_only = true

[node name="MOTION" type="Node"]
script = ExtResource("1")
kind = 0

[node name="Sync" type="NetcodeSharedReplicator" parent="."]
replication_config = SubResource("Fields")
