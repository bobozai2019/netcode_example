[gd_scene format=3]

[ext_resource type="Script" path="res://lab.gd" id="1"]
[ext_resource type="Script" path="res://arena.gd" id="Arena"]

[sub_resource type="SystemFont" id="Font"]
font_names = PackedStringArray("Microsoft YaHei UI", "Microsoft YaHei", "Noto Sans CJK SC")

[sub_resource type="StyleBoxFlat" id="Input"]
content_margin_left = 11.0
content_margin_top = 6.0
content_margin_right = 11.0
content_margin_bottom = 6.0
bg_color = Color(0.086275, 0.156863, 0.223529, 1)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.215686, 0.329412, 0.419608, 1)
corner_radius_top_left = 5
corner_radius_top_right = 5
corner_radius_bottom_right = 5
corner_radius_bottom_left = 5

[sub_resource type="StyleBoxFlat" id="InputActive"]
content_margin_left = 11.0
content_margin_top = 6.0
content_margin_right = 11.0
content_margin_bottom = 6.0
bg_color = Color(0.145098, 0.282353, 0.356863, 1)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.215686, 0.329412, 0.419608, 1)
corner_radius_top_left = 5
corner_radius_top_right = 5
corner_radius_bottom_right = 5
corner_radius_bottom_left = 5

[sub_resource type="Theme" id="LabTheme"]
default_font = SubResource("Font")
default_font_size = 14
Button/colors/font_color = Color(0.913725, 0.952941, 0.968627, 1)
Button/styles/disabled = SubResource("Input")
Button/styles/focus = SubResource("InputActive")
Button/styles/hover = SubResource("InputActive")
Button/styles/normal = SubResource("Input")
Button/styles/pressed = SubResource("InputActive")
HBoxContainer/constants/separation = 8
LineEdit/colors/font_color = Color(0.913725, 0.952941, 0.968627, 1)
LineEdit/styles/focus = SubResource("InputActive")
LineEdit/styles/normal = SubResource("Input")
LineEdit/styles/read_only = SubResource("Input")
MarginContainer/constants/margin_bottom = 17
MarginContainer/constants/margin_left = 17
MarginContainer/constants/margin_right = 17
MarginContainer/constants/margin_top = 17
OptionButton/colors/font_color = Color(0.913725, 0.952941, 0.968627, 1)
OptionButton/styles/disabled = SubResource("Input")
OptionButton/styles/focus = SubResource("InputActive")
OptionButton/styles/hover = SubResource("InputActive")
OptionButton/styles/normal = SubResource("Input")
OptionButton/styles/pressed = SubResource("InputActive")
VBoxContainer/constants/separation = 9

[node name="SyncLab" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = SubResource("LabTheme")
script = ExtResource("1")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Body" type="VBoxContainer" parent="Margin"]
layout_mode = 2

[node name="Title" type="HBoxContainer" parent="Margin/Body"]
layout_mode = 2

[node name="Heading" type="Label" parent="Margin/Body/Title"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0.913725, 0.952941, 0.968627, 1)
theme_override_font_sizes/font_size = 24
text = "同步试验场"

[node name="Status" type="Label" parent="Margin/Body/Title"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.364706, 0.886275, 0.694118, 1)
text = "等待连接"
vertical_alignment = 1

[node name="Connection" type="HBoxContainer" parent="Margin/Body"]
layout_mode = 2

[node name="BackendPicker" type="OptionButton" parent="Margin/Body/Connection"]
unique_name_in_owner = true
layout_mode = 2
item_count = 2
selected = 0
popup/item_0/text = "Netcode"
popup/item_0/id = 0
popup/item_1/text = "Fusion"
popup/item_1/id = 1

[node name="Endpoint" type="LineEdit" parent="Margin/Body/Connection"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
text = "127.0.0.1:43231"
placeholder_text = "主机地址:端口"

[node name="ObjectCount" type="OptionButton" parent="Margin/Body/Connection"]
unique_name_in_owner = true
layout_mode = 2
item_count = 5
selected = 2
popup/item_0/text = "32 对象"
popup/item_0/id = 32
popup/item_1/text = "64 对象"
popup/item_1/id = 64
popup/item_2/text = "128 对象"
popup/item_2/id = 128
popup/item_3/text = "512 对象"
popup/item_3/id = 512
popup/item_4/text = "1024 对象"
popup/item_4/id = 1024

[node name="Host" type="Button" parent="Margin/Body/Connection"]
unique_name_in_owner = true
layout_mode = 2
text = "开房"

[node name="Join" type="Button" parent="Margin/Body/Connection"]
unique_name_in_owner = true
layout_mode = 2
text = "加入"

[node name="Leave" type="Button" parent="Margin/Body/Connection"]
unique_name_in_owner = true
layout_mode = 2
disabled = true
text = "退出"

[node name="Controls" type="HBoxContainer" parent="Margin/Body"]
layout_mode = 2

[node name="Stats" type="Label" parent="Margin/Body/Controls"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0.635294, 0.721569, 0.784314, 1)
theme_override_font_sizes/font_size = 13
text = "房间承载 2 名玩家"
vertical_alignment = 1

[node name="Pause" type="Button" parent="Margin/Body/Controls"]
unique_name_in_owner = true
layout_mode = 2
disabled = true
text = "暂停负载"

[node name="Aoi" type="Button" parent="Margin/Body/Controls"]
unique_name_in_owner = true
layout_mode = 2
disabled = true
text = "客端 AOI：全部"

[node name="Arena" type="Control" parent="Margin/Body"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 300)
layout_mode = 2
size_flags_vertical = 3
script = ExtResource("Arena")

[node name="Hint" type="Label" parent="Margin/Body"]
layout_mode = 2
theme_override_colors/font_color = Color(0.635294, 0.721569, 0.784314, 1)
theme_override_font_sizes/font_size = 12
text = "WASD / 方向键移动  ·  房主可切换客端 AOI 和暂停负载  ·  负载对象 10 Hz"

[connection signal="item_selected" from="Margin/Body/Connection/BackendPicker" to="." method="_select_backend"]
[connection signal="item_selected" from="Margin/Body/Connection/ObjectCount" to="." method="_select_object_count"]
[connection signal="pressed" from="Margin/Body/Connection/Host" to="." method="_connect_room" binds= [true]]
[connection signal="pressed" from="Margin/Body/Connection/Join" to="." method="_connect_room" binds= [false]]
[connection signal="pressed" from="Margin/Body/Connection/Leave" to="." method="_close_room" binds= ["已退出房间"]]
[connection signal="pressed" from="Margin/Body/Controls/Pause" to="." method="_toggle_pause"]
[connection signal="pressed" from="Margin/Body/Controls/Aoi" to="." method="_change_area"]
[connection signal="resized" from="Margin/Body/Arena" to="Margin/Body/Arena" method="_resize_circle_bounds"]
