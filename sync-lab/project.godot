; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Godot 同步压测"
run/main_scene="res://lab.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
run/max_fps=60

[display]

window/size/viewport_width=920
window/size/viewport_height=660
window/stretch/mode="canvas_items"

[fusion]

connection/default_region="asia"
connection/mode=1

[rendering]

renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.043, 0.068, 0.1, 1)
