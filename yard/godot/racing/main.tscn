[gd_scene format=3]

[ext_resource type="Script" path="res://racing/main.gd" id="1"]
[ext_resource type="Script" path="res://addons/netcode/scene_spawner.gd" id="2"]
[ext_resource type="PackedScene" path="res://racing/vehicle.tscn" id="3"]
[ext_resource type="PackedScene" path="res://racing/roadster.tscn" id="4"]

[node name="Racing" type="Node2D"]
script = ExtResource("1")

[node name="Asphalt" type="Polygon2D" parent="."]
color = Color(0.14, 0.18, 0.20, 1)
polygon = PackedVector2Array(8,130, 952,130, 952,632, 8,632)

[node name="Boundary" type="Line2D" parent="."]
points = PackedVector2Array(24,154, 936,154, 936,610, 24,610, 24,154)
width = 3.0
default_color = Color(0.79, 0.81, 0.72, 1)

[node name="StartLine" type="Line2D" parent="."]
points = PackedVector2Array(130,160, 130,604)
width = 5.0
default_color = Color(0.68, 0.70, 0.61, 1)

[node name="Vehicles" type="Node2D" parent="."]

[node name="Spawner" type="Node" parent="."]
script = ExtResource("2")
spawn_path = NodePath("../Vehicles")
spawnable_scenes = Array[PackedScene]([ExtResource("3"), ExtResource("4")])

[node name="UI" type="CanvasLayer" parent="."]

[node name="Setup" type="HBoxContainer" parent="UI"]
offset_left = 24.0
offset_top = 20.0

[node name="Address" type="LineEdit" parent="UI/Setup"]
unique_name_in_owner = true
text = "127.0.0.1"
tooltip_text = "房主 IPv4 地址"
custom_minimum_size = Vector2(145, 38)

[node name="Port" type="SpinBox" parent="UI/Setup"]
unique_name_in_owner = true
min_value = 1
max_value = 65535
value = 43240

[node name="Model" type="OptionButton" parent="UI/Setup"]
unique_name_in_owner = true
item_count = 2
popup/item_0/text = "标准车"
popup/item_0/id = 0
popup/item_1/text = "跑车"
popup/item_1/id = 1
selected = 0

[node name="Host" type="Button" parent="UI/Setup"]
unique_name_in_owner = true
text = "创建房间"

[node name="Join" type="Button" parent="UI/Setup"]
unique_name_in_owner = true
text = "加入房间"

[node name="Legacy" type="Button" parent="UI/Setup"]
unique_name_in_owner = true
text = "完整车场"

[node name="Status" type="Label" parent="UI"]
offset_left = 24.0
offset_top = 77.0
text = "选择车型后，创建或加入房间"

[node name="Leave" type="Button" parent="UI"]
unique_name_in_owner = true
visible = false
offset_left = 24.0
offset_top = 20.0
text = "离开房间"

[connection signal="room_joined" from="Spawner" to="." method="_on_joined"]
[connection signal="room_closed" from="Spawner" to="." method="_on_closed"]
[connection signal="pressed" from="UI/Setup/Host" to="." method="_host_room"]
[connection signal="pressed" from="UI/Setup/Join" to="." method="_join_room"]
[connection signal="pressed" from="UI/Setup/Legacy" to="." method="_open_yard"]
[connection signal="pressed" from="UI/Leave" to="Spawner" method="close"]
